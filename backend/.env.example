# Porta HTTP do servidor.
PORT=8080

# Origens que podem chamar a API pelo navegador (CORS), separadas por vírgula.
# Vazio ou "*" aceita qualquer origem (bom para desenvolvimento).
CORS_ORIGINS=

# Pasta da cache em disco. Vazio = pasta de cache do usuário
# (%LocalAppData%\quem-eu-voto no Windows, ~/.cache/quem-eu-voto no Linux).
CACHE_DIR=
